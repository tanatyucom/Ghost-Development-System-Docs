{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://gds.example/schemas/ai-development/execution-package.schema.json",
  "title": "Execution Package 1.0.0", "type": "object",
  "required": ["schema_id", "schema_version", "q_id", "execution_id", "correlation_id", "repository", "approved_q", "mutation_authority", "allowed_paths", "prohibited_paths", "required_capabilities", "validation_commands", "completion_gate", "approval_references", "source_artifact_references", "context_package", "classification", "retention_class", "execution_timeout_seconds", "retry_safety"],
  "properties": {
    "schema_id": {"$ref": "common.schema.json#/$defs/id"}, "schema_version": {"$ref": "common.schema.json#/$defs/version"},
    "q_id": {"$ref": "common.schema.json#/$defs/id"}, "execution_id": {"$ref": "common.schema.json#/$defs/id"}, "correlation_id": {"$ref": "common.schema.json#/$defs/id"},
    "repository": {"type": "object", "required": ["repository_id", "root", "branch", "expected_head"], "properties": {"repository_id": {"$ref": "common.schema.json#/$defs/id"}, "root": {"type": "string"}, "branch": {"type": "string"}, "expected_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}}, "additionalProperties": false},
    "approved_q": {"type": "object"}, "mutation_authority": {"type": "string"}, "allowed_paths": {"$ref": "common.schema.json#/$defs/stringArray"}, "prohibited_paths": {"$ref": "common.schema.json#/$defs/stringArray"},
    "required_capabilities": {"$ref": "common.schema.json#/$defs/stringArray"}, "validation_commands": {"$ref": "common.schema.json#/$defs/stringArray"}, "completion_gate": {"$ref": "common.schema.json#/$defs/stringArray"},
    "approval_references": {"type": "array", "minItems": 1, "items": {"$ref": "approval-reference.schema.json"}}, "source_artifact_references": {"type": "array", "items": {"$ref": "common.schema.json#/$defs/id"}},
    "context_package": {"type": "object"}, "classification": {"$ref": "common.schema.json#/$defs/classification"}, "retention_class": {"$ref": "common.schema.json#/$defs/retention"},
    "execution_timeout_seconds": {"type": "integer", "minimum": 1}, "retry_safety": {"enum": ["SAFE", "CONDITIONAL", "UNSAFE"]}
  }, "additionalProperties": false
}
