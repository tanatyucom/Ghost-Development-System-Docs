{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gds.example/schemas/ai-development/common.schema.json",
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256},
    "nullableId": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
    "timestamp": {"type": "string", "format": "date-time"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "classification": {"enum": ["PUBLIC", "INTERNAL", "SENSITIVE", "SECRET_PROHIBITED"]},
    "retention": {"enum": ["TRANSIENT_7D", "WORKFLOW_90D", "AUDIT_7Y", "CANONICAL", "SECURITY_HOLD"]},
    "stringArray": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
